:root {
  color-scheme: dark;
  --bg: #090b12;
  --panel: #111521;
  --panel-soft: #171d2b;
  --text: #f4f5f8;
  --muted: #9299aa;
  --accent: #a78bfa;
  --accent-strong: #8b5cf6;
  --line: rgba(255,255,255,.09);
}

* { box-sizing: border-box; }
html { min-height: 100%; background: var(--bg); }
body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(ellipse at 80% -20%, rgba(105,79,180,.2), transparent 38%), var(--bg);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
button, input { font: inherit; }
button { color: inherit; cursor: pointer; }
button:disabled { cursor: wait; opacity: .55; }
:focus-visible { outline: 3px solid #c4b5fd !important; outline-offset: 4px; }
.boot-screen, .login-screen { min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 32px; }
.boot-screen { gap: 16px; color: var(--muted); }
.brand-mark { display: inline-grid; place-items: center; width: 54px; height: 54px; border-radius: 17px; background: linear-gradient(145deg, #b69cff, #7144d6); color: #100b1e; font-size: 30px; font-weight: 900; box-shadow: 0 8px 32px rgba(139,92,246,.25); }
.login-brand, .wordmark { display: flex; align-items: center; gap: 13px; font-size: 21px; font-weight: 850; letter-spacing: .12em; }
.login-brand { margin-bottom: 36px; }
.login-panel { width: min(100%, 510px); padding: 42px; border: 1px solid var(--line); border-radius: 28px; background: rgba(17,21,33,.92); box-shadow: 0 28px 90px rgba(0,0,0,.35); }
.eyebrow { margin: 0 0 10px; color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: .19em; }
.login-panel h1 { margin: 0 0 27px; font-size: clamp(27px, 4vw, 35px); letter-spacing: -.04em; }
.profile-list { display: flex; gap: 12px; flex-wrap: wrap; }
.profile-choice { display: flex; align-items: center; gap: 11px; min-width: 150px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel-soft); font-weight: 700; }
.profile-choice.selected { border-color: var(--accent); background: rgba(139,92,246,.15); }
.profile-avatar { display: grid; place-items: center; width: 39px; height: 39px; border-radius: 12px; background: linear-gradient(145deg,#8b5cf6,#4c36a4); font-size: 18px; }
.pin-form { display: grid; gap: 12px; margin-top: 26px; }
.pin-form label { color: #d9dbea; font-size: 14px; font-weight: 650; }
.pin-form input, .search-box input { width: 100%; border: 1px solid var(--line); border-radius: 13px; background: #0b0e17; color: white; padding: 14px 16px; outline: none; }
.pin-form input:focus, .search-box:focus-within { border-color: var(--accent); }
.primary-button { border: 0; border-radius: 13px; padding: 14px 20px; background: linear-gradient(105deg,#a78bfa,#8054e8); color: #100b1e; font-weight: 850; }
.primary-button.compact { padding: 11px 16px; }
.login-footer { margin-top: 26px; color: #72798a; font-size: 12px; }
.error-message { margin: 17px 0 0; color: #fda4af; font-size: 14px; }
.muted { color: var(--muted); }
.app-shell { min-height: 100vh; padding: 0 clamp(24px,5vw,82px) 70px; }
.topbar { height: 88px; display: flex; align-items: center; gap: 54px; border-bottom: 1px solid var(--line); }
.brand-mark.small { width: 38px; height: 38px; border-radius: 12px; font-size: 22px; }
.wordmark { font-size: 17px; }
.main-nav { display: flex; gap: 28px; color: #969bad; font-size: 14px; font-weight: 650; }
.nav-active { color: white; position: relative; }
.nav-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -34px; height: 3px; border-radius: 3px; background: var(--accent); }
.account-actions { margin-left: auto; display: flex; align-items: center; gap: 18px; }
.profile-label { color: #c7cada; font-size: 13px; }
.quiet-button { border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,.04); padding: 10px 15px; color: #e3e5ee; font-weight: 700; }
.welcome-block { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: clamp(48px,8vh,88px) 0 54px; }
.welcome-block h1 { margin: 0; font-size: clamp(38px,5.3vw,66px); line-height: 1.05; letter-spacing: -.055em; }
.welcome-block h1 span { color: #b9a3ff; }
.welcome-copy { margin: 17px 0 0; color: var(--muted); font-size: 16px; }
.server-status { display: flex; align-items: center; gap: 9px; padding: 11px 15px; border: 1px solid var(--line); border-radius: 999px; color: #b6bdcb; font-size: 12px; white-space: nowrap; }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 14px #4ade80; }
.catalog-section { padding-top: 10px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 22px; }
.section-heading h2 { margin: 0; font-size: 29px; letter-spacing: -.04em; }
.count { margin-left: 8px; color: #8d93a4; font-size: 15px; font-weight: 500; }
.catalog-tools { display: flex; align-items: center; gap: 11px; }
.search-box { display: flex; align-items: center; gap: 8px; width: min(290px,28vw); padding-left: 13px; border: 1px solid var(--line); border-radius: 13px; background: #0b0e17; color: #8d93a4; }
.search-box input { border: 0; background: transparent; padding: 11px 9px 11px 0; }
.filter-row { display: flex; gap: 9px; margin: 22px 0 26px; }
.filter-chip { border: 1px solid var(--line); border-radius: 999px; padding: 9px 17px; background: rgba(255,255,255,.035); color: #aeb4c3; font-size: 13px; font-weight: 700; }
.filter-chip.active { border-color: rgba(167,139,250,.65); background: rgba(139,92,246,.18); color: #e6ddff; }
.media-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap: 28px 18px; }
.media-card { display: flex; flex-direction: column; align-items: stretch; min-width: 0; padding: 0; border: 0; background: transparent; text-align: left; }
.poster-wrap { position: relative; display: block; overflow: hidden; aspect-ratio: 16/9; border-radius: 15px; background: linear-gradient(145deg,#242a3a,#121521); box-shadow: 0 8px 25px rgba(0,0,0,.22); }
.poster-image { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .25s ease; }
.poster-placeholder { display: grid; place-items: center; width: 100%; height: 100%; color: #b9a3ff; font-size: 21px; font-weight: 900; letter-spacing: .12em; }
.poster-overlay { position: absolute; inset: 0; display: flex; align-items: end; justify-content: center; padding: 18px; background: linear-gradient(transparent 45%,rgba(4,5,10,.85)); opacity: 0; transition: opacity .2s ease; color: white; font-size: 13px; font-weight: 750; }
.media-card:hover .poster-overlay, .media-card:focus-visible .poster-overlay { opacity: 1; }
.media-card:hover .poster-image, .media-card:focus-visible .poster-image { transform: scale(1.045); }
.media-title { overflow: hidden; margin-top: 12px; color: #f1f2f6; font-size: 14px; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.media-meta { margin-top: 5px; color: #858c9d; font-size: 12px; }
.empty-state { display: flex; min-height: 245px; align-items: center; justify-content: center; flex-direction: column; padding: 30px; border: 1px dashed rgba(255,255,255,.13); border-radius: 20px; background: rgba(255,255,255,.018); text-align: center; }
.empty-icon { color: #a78bfa; font-size: 34px; }
.empty-state h3 { margin: 12px 0 6px; font-size: 21px; }
.empty-state p { max-width: 470px; margin: 0 0 18px; color: var(--muted); line-height: 1.6; }
.catalog-error { margin-bottom: 18px; }
.dialog-backdrop { position: fixed; z-index: 10; inset: 0; display: grid; place-items: center; padding: 24px; background: rgba(2,3,8,.78); backdrop-filter: blur(12px); }
.detail-dialog { position: relative; overflow: hidden; width: min(780px,100%); min-height: 400px; border: 1px solid var(--line); border-radius: 24px; background: #111521; box-shadow: 0 30px 100px rgba(0,0,0,.6); }
.detail-backdrop { position: absolute; inset: 0 0 auto; width: 100%; height: 220px; object-fit: cover; opacity: .28; mask-image: linear-gradient(#000,transparent); }
.detail-content { position: relative; padding: 72px 42px 38px; }
.detail-layout { display: grid; grid-template-columns: 150px minmax(0,1fr); align-items: start; gap: 26px; }
.detail-poster { display: block; width: 100%; aspect-ratio: 2/3; border-radius: 14px; object-fit: cover; background: var(--panel-soft); box-shadow: 0 12px 34px rgba(0,0,0,.35); }
.detail-copy { min-width: 0; }
.detail-content h2 { margin: 0; font-size: clamp(30px,5vw,44px); letter-spacing: -.04em; }
.detail-meta { color: #b7bdcd; font-size: 13px; }
.detail-synopsis { max-width: 650px; color: #d4d7e1; line-height: 1.7; }
.detail-close, .dialog-close { position: absolute; z-index: 2; top: 17px; right: 18px; display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 50%; background: rgba(5,7,12,.75); font-size: 25px; }
.small-note { margin-top: 24px; font-size: 12px; }
@media (min-width: 1500px) { .media-grid { grid-template-columns: repeat(auto-fill,minmax(190px,1fr)); gap: 34px 24px; } }
@media (max-width: 760px) {
  .app-shell { padding: 0 20px 48px; }
  .topbar { height: 72px; gap: 16px; }
  .main-nav { display: none; }
  .welcome-block { align-items: start; flex-direction: column; padding: 48px 0 38px; }
  .server-status { align-self: start; }
  .section-heading { align-items: stretch; flex-direction: column; }
  .catalog-tools { align-items: stretch; flex-direction: column; }
  .search-box { width: 100%; }
  .media-grid { grid-template-columns: repeat(auto-fill,minmax(125px,1fr)); gap: 22px 12px; }
  .login-panel { padding: 28px 22px; }
  .detail-content { padding: 72px 22px 28px; }
  .detail-layout { grid-template-columns: 105px minmax(0,1fr); gap: 16px; }
}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
