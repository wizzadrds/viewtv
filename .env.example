# Copia este archivo a .env y cambia los valores antes de ejecutar servicios.
# No guardes secretos reales en Git.

# Aplicación
VIEWTV_ENV=development
VIEWTV_TIMEZONE=Europe/Madrid
VIEWTV_LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_ACCESS_TOKEN_MINUTES=30
PIN_HASHING_MEMORY_COST=65536

# Persistencia: fuera de la caché temporal
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/viewtv.db

# Caché multimedia temporal
CACHE_DIR=./cache
CACHE_QUOTA_GB=80

# Jellyfin (servidor existente en la LAN)
JELLYFIN_BASE_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Metadatos TMDB v3
TMDB_API_KEY=

# Integraciones opcionales; completar solo para fuentes autorizadas
PROWLARR_BASE_URL=
PROWLARR_API_KEY=
QBITTORRENT_BASE_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Interfaz
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
