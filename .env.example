# Copia este archivo a .env y cambia los valores antes de ejecutar servicios.
# No guardes secretos reales en Git.

# Aplicación
VIEWTV_ENV=development
VIEWTV_TIMEZONE=Europe/Madrid

# API y autenticación
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=viewtv_session
# false solo para desarrollo local HTTP; usa true cuando el acceso vaya por HTTPS.
AUTH_COOKIE_SECURE=false

# Persistencia: fuera de la caché temporal
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/viewtv.db

# Caché multimedia temporal
CACHE_DIR=./cache
CACHE_QUOTA_GB=80

# Copias SQLite (retención aplicada tras crear y validar cada backup)
BACKUP_RETENTION_DAYS=30

# Jellyfin nativo en Windows; desde Docker Desktop se alcanza mediante host.docker.internal.
JELLYFIN_BASE_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_TIMEOUT_SECONDS=5

# Metadatos TMDB v3
TMDB_API_KEY=

# Prowlarr queda reservado; la integración de búsqueda de esta fase usa Jackett.
PROWLARR_BASE_URL=
PROWLARR_API_KEY=

# Descargas mediante servicios instalados en Windows, accesibles desde Docker.
JACKETT_BASE_URL=http://host.docker.internal:9117
JACKETT_API_KEY=
JACKETT_TIMEOUT_SECONDS=20

QBITTORRENT_BASE_URL=http://host.docker.internal:8080
QBITTORRENT_API_KEY=
QBITTORRENT_TIMEOUT_SECONDS=10

# Interfaz
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Configuración de fuentes Torznab
# Jackett está instalado en Windows.
INDEXER_BASE_URL=http://host.docker.internal:9117/api/v2.0/indexers/all/results/torznab
INDEXER_API_KEY=
INDEXER_COOLDOWN_MINUTES=30

# Dirección de FlareSolverr para Jackett en Windows.
FLARESOLVERR_URL=http://127.0.0.1:8191
